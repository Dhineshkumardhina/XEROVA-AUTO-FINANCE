{
  "name": "xerova-auto-finance-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "overrides": {
    "qs": "^6.16.0",
    "express": {
      "qs": "^6.16.0"
    },
    "body-parser": {
      "qs": "^6.16.0"
    }
  },
  "scripts": {
    "dev": "concurrently \"npm run dev -w @xerova/backend\" \"npm run dev -w @xerova/frontend\"",
    "dev:backend": "npm run dev -w @xerova/backend",
    "dev:frontend": "npm run dev -w @xerova/frontend",
    "seed": "npm run seed -w @xerova/database",
    "build": "npm run build -w @xerova/database && npm run build -w @xerova/backend && npm run build -w @xerova/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
