# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. Underwriting risk score, Fraud check).
GEMINI_API_KEY="your_gemini_api_key_here"

# MONGODB_URI: MongoDB Atlas connection string for production database persistence.
# If omitted or unavailable, the backend automatically falls back to an in-memory MongoDB instance.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/xerova_auto_finance?retryWrites=true&w=majority"

# ALLOWED_ORIGINS: Comma-separated CORS allowed origins (e.g., your Vercel deployment URL).
ALLOWED_ORIGINS="https://your-app.vercel.app,http://localhost:5173"

# APP_URL: The public production URL of your deployment.
APP_URL="https://your-app.vercel.app"
