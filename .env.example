# ==============================================================================
# XEROVA AUTO FINANCE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. GEMINI AI API (Required for AI Credit Scoring, Fraud Check & Financial Audits)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. DATABASE PERSISTENCE (Neon / Supabase / AWS PostgreSQL)
# For Vercel production, provide your cloud PostgreSQL connection string:
# Example (Neon pooled connection):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-floral-leaf-b5r82avv-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Note: If DATABASE_URL is not set, the backend falls back to an embedded in-memory PostgreSQL instance.

# 3. CORS & HOST CONFIGURATION
# Production Vercel domain (all *.vercel.app domains are also auto-allowed):
ALLOWED_ORIGINS="https://xerova-auto-finance.vercel.app,http://localhost:5173"
APP_URL="https://xerova-auto-finance.vercel.app"
NODE_ENV="production"
