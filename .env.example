# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. Underwriting risk score, Fraud check).
GEMINI_API_KEY="your_gemini_api_key_here"

# DATABASE_URL / POSTGRES_URL: PostgreSQL connection string for production database persistence.
# If omitted or unavailable, the backend automatically falls back to an embedded PostgreSQL (PGlite) instance.
DATABASE_URL="postgresql://postgres:password@ep-cool-db-12345.us-east-1.aws.neon.tech/xerova_auto_finance?sslmode=require"

# ALLOWED_ORIGINS: Comma-separated CORS allowed origins (e.g., your Vercel deployment URL).
ALLOWED_ORIGINS="https://your-app.vercel.app,http://localhost:5173"

# APP_URL: The public production URL of your deployment.
APP_URL="https://your-app.vercel.app"
